{
  "expo": {
    "name": "Genie",
    "slug": "genie",
    "version": "1.0.14",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.post4ex.geniereact",
      "versionCode": 15,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-splash-screen",
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Genie to use your camera to scan barcodes and QR codes and capture shipment documents."
        }
      ]
    ],
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://raw.githubusercontent.com/post4ex/genie-app/main/dist/android-index.json"
    },
    "extra": {
      "eas": {
        "projectId": "87ffdf1c-f236-4171-aa31-e40df5f73966"
      }
    },
    "runtimeVersion": "1.0.14"
  }
}
